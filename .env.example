# Claude (Anthropic API): the Banker and the setup step. Optional per-role keys fall back to this one.
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_SCOUT=
# ANTHROPIC_API_KEY_BANKER=

# Google Gemini: Scout (free key from aistudio.google.com). Without it, Scout uses Claude.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# PayPal sandbox REST app (its own sandbox business account)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Public address of the app, used for PayPal's return links (optional locally)
# APP_URL=https://your-app.up.railway.app
